{
  "root": "../../..",
  "defaults": {
    "css": ["assets/css/styles.css", "assets/style.css"],
    "vars": { "bg": "--bg", "fg": "--text", "accent": "--accent" },
    "description": "index.html",
    "font": "sans",
    "out": "assets/og-image.png"
  },
  "sites": [
    { "repo": "aim-trainer", "domain": "flicktrainer.com", "wordmark": "Flick*Trainer*" },
    { "repo": "click-speed-test", "domain": "cpsboost.com", "wordmark": "cps*boost*" },
    { "repo": "clocklab", "domain": "clocklab.net", "wordmark": "*[*clocklab*]*",
      "vars": { "bg": "--panel", "fg": "--ink", "accent": "--amber" } },
    { "repo": "dev-tools", "domain": "devboxkit.com", "wordmark": "*{*devbox*/*kit*}*", "font": "mono" },
    { "repo": "drawlots", "domain": "drawlots.net", "wordmark": "draw*•*lots", "font": "rounded",
      "vars": { "bg": "--bg", "fg": "--text", "accent": "--lot-coral" } },
    { "repo": "fancy-text-generator", "domain": "fontloom.com", "wordmark": "font*loom*" },
    { "repo": "generateascii", "domain": "inascii.com", "wordmark": "*[*in*/*ascii*]*", "font": "mono" },
    { "repo": "hardware-checkup", "domain": "hardwarecheckup.com", "wordmark": "*[*hw*/*checkup*]*", "font": "mono" },
    { "repo": "hueshift", "domain": "gamutlens.com", "wordmark": "gamut*lens*",
      "vars": { "bg": "--ink", "fg": "--paper", "accent": "--sig-magenta" } },
    { "repo": "memory-test", "domain": "chimpmemory.com", "wordmark": "Chimp*Memory*",
      "vars": { "bg": "--bg", "fg": "--text", "accent": "--accent-dim" } },
    { "repo": "notepadly", "domain": "blanknotepad.com", "wordmark": "blank *notepad*", "font": "serif",
      "vars": { "bg": "--paper", "fg": "--ink", "accent": "--accent" } },
    { "repo": "paperprintouts", "domain": "paperprintouts.com", "wordmark": "paper*printouts*",
      "vars": { "bg": "--bg", "fg": "--ink", "accent": "--accent" } },
    { "repo": "perfecttune", "domain": "perfecttune.net", "wordmark": "perfect*tune*", "font": "serif",
      "vars": { "bg": "--bg", "fg": "--fg", "accent": "--accent" } },
    { "repo": "photoshrink", "domain": "photoshrink.net", "wordmark": "photo*shrink*",
      "vars": { "bg": "--paper", "fg": "--ink", "accent": "--coral" } },
    { "repo": "qrmint", "domain": "qrmint.net", "wordmark": "QR*mint*", "font": "rounded",
      "vars": { "bg": "--bg", "fg": "--text", "accent": "--mint-dim" } },
    { "repo": "reaction-time-test", "domain": "reflexzap.com", "wordmark": "Reflex*Zap*" },
    { "repo": "stick-drift-check", "domain": "stickdriftcheck.com", "wordmark": "*[*stick*/*drift*]*", "font": "mono" },
    { "repo": "text-tools", "domain": "textkitpro.com", "wordmark": "TextKit *Pro*" },
    { "repo": "typing-speed-test", "domain": "wpmflex.com", "wordmark": "*[*wpm*/*flex*]*", "font": "mono" },
    { "repo": "calculatoreuphoria-site", "domain": "calculatoreuphoria.com", "wordmark": "Calculator*Euphoria*",
      "vars": { "bg": "--bg", "fg": "--text", "accent": "--primary" } },
    { "repo": "ngineer420.github.io", "domain": "erabb.it", "wordmark": "eRabb*.it*", "font": "mono",
      "colors": { "bg": "#2e3436", "fg": "#8ae234", "accent": "#8ae234" },
      "description": "projects/index.html",
      "out": "public/assets/og-image.png" }
  ]
}
